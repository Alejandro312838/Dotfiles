#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    draw_borders: false,
    show_song_table_header: false,
    symbols: (song: "🎵", dir: "📁", playlist: "🎼", marker: "\u{e0b0}"),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "1",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    progress_bar: (
        symbols: ["", "", "⭘", " ", " "],
        track_style: (bg: "#1e1e2e"),
        elapsed_style: (fg: "#89b4fa", bg: "#1e1e2e"),
        thumb_style: (fg: "#89b4fa", bg: "#1e1e2e"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#f38ba8"),
    ),
    browser_column_widths: [20, 38, 42],
    text_color: "#cdd6f4",
    background_color: "#1e1e2e",
    header_background_color: "#313244",
    modal_background_color: None,
    modal_backdrop: false,
    tab_bar: (
        active_style: (fg: "#1e1e2e", bg: "#f9e2af", modifiers: "Bold"),
        inactive_style: (fg: "#bac2de", bg: "#1e1e2e")
    ),
    borders_style: (fg: "#6c6f93"),
    highlighted_item_style: (fg: "#89b4fa", modifiers: "Bold"),
    current_item_style: (fg: "#1e1e2e", bg: "#f38ba8", modifiers: "Bold"),
    highlight_border_style: (fg: "#f38ba8"),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#89b4fa"), default: (kind: Text("Unknown"))),
            width: "50%",
            alignment: Right,
        ),
        (
            prop: (kind: Text("-"), style: (fg: "#f5c2e7"), default: (kind: Text("Unknown"))),
            width: "1",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#f9e2af"), default: (kind: Text("Unknown"))),
            width: "50%",
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "#89b4fa", modifiers: "Bold")),
                    (kind: Property(Status(State)), style: (fg: "#89b4fa", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "#89b4fa", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#f9e2af", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#f9e2af", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Title)), style: (fg: "#f38ba8", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#f38ba8", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#f5c2e7", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#f5c2e7", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#f5c2e7", modifiers: "Bold"))
                ]
            )
        ],
    ),
)

